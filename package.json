{
	"name": "tabelhaport",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url cookie preferredLanguage baseLocale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url cookie preferredLanguage baseLocale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"cv": "node scripts/cv.mjs",
		"cv:dev-en": "node scripts/cv.mjs dev en",
		"cv:dev-pt": "node scripts/cv.mjs dev pt",
		"cv:tutor-en": "node scripts/cv.mjs tutor en",
		"cv:tutor-pt": "node scripts/cv.mjs tutor pt",
		"cv:all-en": "node scripts/cv.mjs all en",
		"cv:all-pt": "node scripts/cv.mjs all pt",
		"cv:watch": "node scripts/cv.mjs watch dev pt",
		"cv:vaga": "bash scripts/cv-vaga.sh",
		"section": "node scripts/section.mjs",
		"prepare-deploy": "bun run cv && bun run format && bun run build",
		"deploy": "bunx wrangler deploy"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.20.2",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^26.0.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"prompts": "^2.4.2",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"wrangler": "^4.105.0"
	},
	"dependencies": {
		"@tabelhadev/tabelhawebui": "^0.28.4",
		"lucide-svelte": "^0.562.0"
	}
}
